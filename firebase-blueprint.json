{
  "entities": {
    "GameScores": {
      "title": "GameScores",
      "description": "Global aggregated game scores for Groom and Bride teams",
      "type": "object",
      "properties": {
        "moshe": {
          "type": "number",
          "description": "Total score for Groom Moshe Dora"
        },
        "priya": {
          "type": "number",
          "description": "Total score for Bride Priya"
        },
        "totalPlays": {
          "type": "number",
          "description": "Total number of game rounds played by guests"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of the last update"
        }
      },
      "required": ["moshe", "priya", "totalPlays"]
    },
    "GamePlayer": {
      "title": "GamePlayer",
      "description": "Individual guest player scores and ranking on the wedding leaderboard",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the player"
        },
        "phone": {
          "type": "string",
          "description": "Phone number used as unique identifier"
        },
        "score": {
          "type": "number",
          "description": "Cumulative total points scored by this player across all games"
        },
        "team": {
          "type": "string",
          "description": "Chosen team (moshe or priya)"
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Number of game rounds completed"
        },
        "lastPlayed": {
          "type": "string",
          "description": "ISO timestamp of last gameplay"
        }
      },
      "required": ["name", "phone", "score", "team", "gamesPlayed"]
    },
    "Blessing": {
      "title": "Blessing",
      "description": "Guest blessing and prayer note",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the guest"
        },
        "city": {
          "type": "string",
          "description": "City or relation of the guest"
        },
        "message": {
          "type": "string",
          "description": "Heartfelt wedding wish or prayer"
        },
        "timestamp": {
          "type": "string",
          "description": "Formatted date or timestamp"
        },
        "likes": {
          "type": "number",
          "description": "Number of likes"
        }
      },
      "required": ["name", "message"]
    },
    "MatchHistory": {
      "title": "MatchHistory",
      "description": "Game match history entry recording player actions, point wins, losses, transfers, and timestamps",
      "type": "object",
      "properties": {
        "playerName": {
          "type": "string",
          "description": "Name of the player"
        },
        "playerPhone": {
          "type": "string",
          "description": "Phone of the player"
        },
        "team": {
          "type": "string",
          "description": "Supported team (moshe or priya)"
        },
        "opponentTeam": {
          "type": "string",
          "description": "Opponent team"
        },
        "gameName": {
          "type": "string",
          "description": "Name of the game played"
        },
        "outcome": {
          "type": "string",
          "description": "Outcome of the game round (won, lost, partial)"
        },
        "pointsWon": {
          "type": "number",
          "description": "Points won in this round"
        },
        "pointsLost": {
          "type": "number",
          "description": "Points lost or penalized"
        },
        "pointsTransferredToOpponent": {
          "type": "number",
          "description": "Points transferred to the rival team"
        },
        "description": {
          "type": "string",
          "description": "Detailed English narrative of the match outcome"
        },
        "teluguDescription": {
          "type": "string",
          "description": "Detailed Telugu narrative of the match outcome"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "formattedTime": {
          "type": "string",
          "description": "Formatted time string"
        },
        "formattedDate": {
          "type": "string",
          "description": "Formatted date string"
        }
      },
      "required": ["playerName", "gameName", "timestamp"]
    }
  },
  "firestore": {
    "/game_scores/{scoreId}": {
      "schema": "GameScores",
      "description": "Shared real-time scores for wedding fun games"
    },
    "/game_leaderboard/{playerId}": {
      "schema": "GamePlayer",
      "description": "Individual player leaderboard entries identified by phone number"
    },
    "/game_history/{historyId}": {
      "schema": "MatchHistory",
      "description": "Live match event timeline logs with point transfers and exact timings"
    },
    "/blessings/{blessingId}": {
      "schema": "Blessing",
      "description": "Real-time guest blessings collection"
    }
  }
}
