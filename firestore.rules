rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global team battle scores
    match /game_scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.resource.data.moshe is number
                           && request.resource.data.priya is number
                           && request.resource.data.totalPlays is number;
      allow delete: if false;
    }

    // Individual guest leaderboard (identified by unique phone number ID)
    match /game_leaderboard/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                           && request.resource.data.name.size() > 0
                           && request.resource.data.name.size() <= 100
                           && request.resource.data.phone is string
                           && request.resource.data.phone.size() >= 4
                           && request.resource.data.score is number
                           && request.resource.data.score >= 0;
      allow delete: if true;
    }

    // Match history logs with point transfers, detailed narration and exact timestamps
    match /game_history/{historyId} {
      allow read: if true;
      allow create: if request.resource.data.playerName is string
                   && request.resource.data.playerName.size() > 0
                   && request.resource.data.gameName is string;
      allow update: if false;
      allow delete: if true;
    }

    // Blessings collection - guests can post, read, and like blessings
    match /blessings/{blessingId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.message is string
                   && request.resource.data.message.size() > 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;
    }
  }
}
